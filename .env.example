# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands to one server instantly while developing.
# Leave empty to register globally (can take up to an hour to show up).
DEV_GUILD_ID=

# SQLite file for development. Swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"
